# Copied to local/.env on first make ensure-env / up / help

# --- Domain (Traefik Host rules + /etc/hosts) ---
NEW_AGE_DOMAIN=new-age.me
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# --- Infra ---
NEW_AGE_POSTGRES_PORT=5435
NEW_AGE_POSTGRES_USER=newage
NEW_AGE_POSTGRES_PASSWORD=newage
NEW_AGE_POSTGRES_DB=new_age
NEW_AGE_REDIS_PORT=6380

PGADMIN_EMAIL=admin@new-age.me
PGADMIN_PASSWORD=admin
PGADMIN_HOST_PORT=5051

# --- Observability (profile otel) — deepilot → Tempo/Loki/Prometheus ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_HOST_PORT=3001
TEMPO_OTLP_HTTP_PORT=4318
TEMPO_HTTP_PORT=3200
LOKI_HTTP_PORT=3100
PROMETHEUS_HTTP_PORT=9090
DEEPILOT_ENVIRONMENT=local
DEEPILOT_TEMPO_ENDPOINT=http://tempo:4318
DEEPILOT_LOKI_ENDPOINT=http://loki:3100/otlp
DEEPILOT_PROMETHEUS_ENDPOINT=http://prometheus:9090/api/v1/otlp
# DEEPILOT_AUTH_SERVICE_NAME=auth-service
# DEEPILOT_PLATFORM_SERVICE_NAME=platform-api

# --- Shared secrets (align auth + platform) ---
JWT_SECRET=change-me
JWT_ISSUER=deepidoo-auth
REDIS_URL=redis://redis:6379/14

# --- App images (GHCR by default; override tag/sha as you version) ---
AUTH_IMAGE=ghcr.io/deepidoo-s-new-age/auth-service:latest
PLATFORM_IMAGE=ghcr.io/deepidoo-s-new-age/platform-api:latest
MONITOR_IMAGE=ghcr.io/deepidoo-s-new-age/deepi-monitor:latest
AUTH_PULL_POLICY=missing
PLATFORM_PULL_POLICY=missing
MONITOR_PULL_POLICY=missing

AUTH_HOST_PORT=8000
AUTH_ADMIN_HOST_PORT=5174
PLATFORM_HOST_PORT=8001
MONITOR_HOST_PORT=8010
MESSAGING_WEB_HOST_PORT=5177
SCHEDULER_HOST_PORT=8002
DEEPIPUSH_HOST_PORT=8011
DEEPIPUSH_WEB_HOST_PORT=5190
DEEPIVOICE_API_HOST_PORT=8003
DEEPIVOICE_WEB_HOST_PORT=5180
DEEPIADS_WEB_HOST_PORT=3012
DEEPIKIOSK_HOST_PORT=3022
DEEPIFLOW_API_HOST_PORT=8004
DEEPIFLOW_WEB_HOST_PORT=5283

# Optionnel — auth-admin / @deepidoo-s-new-age/deesplay :
#   - absent → file: vers le sibling cloné `make clone` (Deepidoo-s-new-age/deesplay)
#   - set (PAT read:packages) → GitHub Packages
# NODE_AUTH_TOKEN=

AUTH_DATABASE_URL=postgresql+asyncpg://newage:newage@postgres:5432/new_age
# Users / login : Postgres webapp (hôte), pas le Postgres New Age du compose
WEBAPP_DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@host.docker.internal:5432/webapp_development

# Transition : platform lit encore la webapp (givemenext_production).
# Cible future = Postgres compose (new_age) + schéma core — voir local/README.md
PLATFORM_DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@host.docker.internal:5432/webapp_development
# deepi_monitor — DB New Age (schéma monitor via initdb) ; optionnel tant que /v1/health seul
MONITOR_DATABASE_URL=postgresql+asyncpg://newage:newage@postgres:5432/new_age
PLATFORM_API_URL=http://platform-api:8000
AUTH_SERVICE_URL=http://auth-service:8000
AUTH_SKIP_JTI_CHECK=false
# M2M module deepi_monitor → platform-api (secret from auth-admin, never commit real value)
MONITOR_MODULE_ID=deepi_monitor
MONITOR_MODULE_CLIENT_ID=deepi_monitor_client
MONITOR_MODULE_CLIENT_SECRET=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://auth-service.new-age.me,http://auth-admin.new-age.me,http://platform-api.new-age.me,http://monitor.new-age.me,http://messaging.new-age.me,http://deepivoice.new-age.me,http://deepiads.new-age.me,http://deepikiosk.new-age.me,http://deepipush.new-age.me,http://scheduler.new-age.me,http://deepiflow.new-age.me
# MONITOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://monitor.new-age.me
