{
  "uid": "deepidoo-workloads",
  "title": "Workloads",
  "description": "CPU and memory usage for pods in the namespace, compared to Kubernetes limits when they are set.",
  "tags": ["deepidoo"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-1h", "to": "now" },
  "graphTooltip": 1,
  "links": [],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(kube_pod_info, namespace)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage",
      "description": "Cores used per container (from kubelet cAdvisor).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": {}, "decimals": 3 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod, container) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\", image!=\"\"}[5m]))",
          "legendFormat": "{{pod}} / {{container}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory working set",
      "description": "Bytes in use (working set), per container.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": {} },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod, container) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\", image!=\"\"})",
          "legendFormat": "{{pod}} / {{container}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU vs limit",
      "description": "Usage as a share of the container CPU limit when limit is set.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod, container) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\", image!=\"\"}[5m])) / on (pod, container) group_left () clamp_min(sum by (pod, container) (kube_pod_container_resource_limits{namespace=\"$namespace\", pod=~\"$pod\", resource=\"cpu\", container!=\"\"}), 0.0001)",
          "legendFormat": "{{pod}} / {{container}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory vs limit",
      "description": "Working set as a share of the container memory limit when limit is set.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod, container) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\", image!=\"\"}) / on (pod, container) group_left () clamp_min(sum by (pod, container) (kube_pod_container_resource_limits{namespace=\"$namespace\", pod=~\"$pod\", resource=\"memory\", container!=\"\"}), 1)",
          "legendFormat": "{{pod}} / {{container}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Current usage snapshot",
      "description": "Latest CPU (cores), memory, and configured limits per container.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "custom": {} },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CPU cores" },
            "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 3 }]
          },
          {
            "matcher": { "id": "byName", "options": "Memory" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          },
          {
            "matcher": { "id": "byName", "options": "CPU limit" },
            "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 3 }]
          },
          {
            "matcher": { "id": "byName", "options": "Memory limit" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Memory", "desc": true }]
      },
      "targets": [
        {
          "refId": "cpu",
          "expr": "sum by (pod, container) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\", image!=\"\"}[5m]))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "mem",
          "expr": "sum by (pod, container) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\", image!=\"\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "cpu_lim",
          "expr": "sum by (pod, container) (kube_pod_container_resource_limits{namespace=\"$namespace\", pod=~\"$pod\", resource=\"cpu\", container!=\"\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "mem_lim",
          "expr": "sum by (pod, container) (kube_pod_container_resource_limits{namespace=\"$namespace\", pod=~\"$pod\", resource=\"memory\", container!=\"\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "container" } },
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value #cpu": "CPU cores", "Value #mem": "Memory", "Value #cpu_lim": "CPU limit", "Value #mem_lim": "Memory limit" } } }
      ]
    }
  ]
}
